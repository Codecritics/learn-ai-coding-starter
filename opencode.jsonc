{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-5": {
          "variants": [
            {
              "id": "poindexter",
              "settings": {
                "reasoningEffort": "high",
                "textVerbosity": "high",
              },
            },
            {
              "id": "grug",
              "settings": {
                "reasoningEffort": "low",
              },
            },
          ],
        },
      },
    },
  }
}
