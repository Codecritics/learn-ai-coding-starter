{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 20000
  },
  "watcher": {
    "ignore": [
      "logs/**"
    ]
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny",
    },
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-5": {
          "variants": [
            {
              "id": "poindexter",
              "settings": {
                "reasoningEffort": "high",
                "textVerbosity": "high",
              },
            },
            {
              "id": "grug",
              "settings": {
                "reasoningEffort": "low",
              },
            },
          ],
        },
      },
    },
  }
}
